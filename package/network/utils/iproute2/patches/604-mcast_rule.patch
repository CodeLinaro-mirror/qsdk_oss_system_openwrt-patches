Index: iproute2-6.11.0/bridge/mcast_rule.c
===================================================================
--- /dev/null
+++ iproute2-6.11.0/bridge/mcast_rule.c
@@ -0,0 +1,325 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ADD mcast-rule action flood utility on bridge with netlink
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <string.h>
+#include <errno.h>
+#include <netinet/in.h>
+
+/* Prevent kernel headers from redefining structures already defined by libc */
+#ifndef _LINUX_IN6_H
+#define _LINUX_IN6_H
+#endif
+
+#include <linux/if_bridge.h>
+
+#include "version.h"
+#include "utils.h"
+#include "br_common.h"
+#include "namespace.h"
+#include "color.h"
+#include "rt_names.h"
+#include "json_print.h"
+
+static int is_bridge_master(const char *dev)
+{
+	char path[PATH_MAX];
+	snprintf(path, sizeof(path), "/sys/class/net/%s/bridge", dev);
+	return access(path, F_OK) == 0;
+}
+
+static int is_ipv4_mcast(__be32 ip)
+{
+	__u32 h = ntohl(ip);
+	return (h & 0xF0000000U) == 0xE0000000U; /* 224.0.0.0/4 */
+}
+
+static int is_ipv6_mcast(const struct in6_addr *ip6)
+{
+	return ip6->s6_addr[0] == 0xFF;
+}
+
+static void mcast_rule_usage(void)
+{
+	fprintf(stderr,
+			"Usage:\n"
+			"  bridge mcast-rule add dev DEV group GROUP action flood\n"
+			"  bridge mcast-rule del dev DEV group GROUP\n"
+			"  bridge mcast-rule show [ dev DEV ]\n"
+			"\n"
+			"Notes:\n"
+			"  - GROUP may be IPv4 or IPv6 multicast address\n"
+			"  - Only action \"flood\" is supported\n");
+	exit(-1);
+}
+
+static int mcast_rule_modify(int cmd, int argc, char **argv)
+{
+	struct {
+		struct nlmsghdr n;
+		struct br_mcast_rule_msg hdr;
+		char buf[1024];
+	} req = {
+		.n.nlmsg_len = NLMSG_LENGTH(sizeof(struct br_mcast_rule_msg)),
+		.n.nlmsg_flags = NLM_F_REQUEST | NLM_F_ACK,
+		.n.nlmsg_type = cmd,
+	};
+	char *dev = NULL;
+	char *group_str = NULL;
+	char *action_kw = NULL;
+	int family = AF_UNSPEC;
+	unsigned int ifindex;
+	unsigned int glen = 0;
+	unsigned char group_bin[16] = {0};
+	int require_action = (cmd == RTM_NEWMCASTRULE);
+
+	while (argc > 0) {
+		if (strcmp(*argv, "dev") == 0) {
+			NEXT_ARG();
+			dev = *argv;
+		} else if (strcmp(*argv, "group") == 0) {
+			NEXT_ARG();
+			group_str = *argv;
+		} else if (strcmp(*argv, "action") == 0) {
+			NEXT_ARG();
+			action_kw = *argv;
+		} else if (matches(*argv, "help") == 0) {
+			mcast_rule_usage();
+		} else {
+			invarg("Unknown argument", *argv);
+		}
+		argc--; argv++;
+	}
+
+	if (!dev || !group_str) {
+		fprintf(stderr, "dev and group are required arguments.\n");
+		return -1;
+	}
+
+	ifindex = ll_name_to_index(dev);
+	if (!ifindex)
+		return nodev(dev);
+
+	/* Optional client-side validation: ensure device is a bridge master */
+	if (!is_bridge_master(dev)) {
+		fprintf(stderr, "Device \"%s\" is not a bridge master (no /sys/class/net/%s/bridge). "
+				"Kernel will enforce as well.\n", dev, dev);
+		/* continue anyway; kernel extack will clarify */
+	}
+
+	/* Determine family and parse group into binary */
+	if (strchr(group_str, ':')) {
+		struct in6_addr ip6;
+		if (!inet_pton(AF_INET6, group_str, &ip6)) {
+			fprintf(stderr, "Invalid IPv6 group \"%s\"\n", group_str);
+			return -1;
+		}
+		family = AF_INET6;
+		glen = 16;
+		memcpy(group_bin, &ip6, glen);
+		if (!is_ipv6_mcast(&ip6)) {
+			fprintf(stderr, "Group \"%s\" is not an IPv6 multicast address.\n",
+					group_str);
+			return -1;
+		}
+	} else {
+		__be32 ip4;
+		if (!inet_pton(AF_INET, group_str, &ip4)) {
+			fprintf(stderr, "Invalid IPv4 group \"%s\"\n", group_str);
+			return -1;
+		}
+		family = AF_INET;
+		glen = 4;
+		memcpy(group_bin, &ip4, glen);
+		if (ip4 == 0 || !is_ipv4_mcast(ip4)) {
+			fprintf(stderr, "Group \"%s\" is not an IPv4 multicast address.\n",
+					group_str);
+			return -1;
+		}
+	}
+
+	/* For add, require "action flood" and reject anything else */
+	if (require_action) {
+		if (!action_kw || strcmp(action_kw, "flood") != 0) {
+			fprintf(stderr, "For add, only \"action flood\" is supported.\n");
+			return -1;
+		}
+	}
+
+	req.hdr.family  = family;       /* AF_INET or AF_INET6 */
+	req.hdr.ifindex = ifindex;      /* bridge ifindex */
+
+	/* Build nested entry with group (and action for add) */
+	{
+		struct rtattr *nest = addattr_nest(&req.n, sizeof(req),
+				BR_MCASTRULE_ENTRY);
+		nest->rta_type |= NLA_F_NESTED;
+
+		addattr_l(&req.n, sizeof(req), BR_MCASTRULE_ENTRY_GROUP,
+				group_bin, glen);
+
+		if (require_action)
+			addattr8(&req.n, sizeof(req), BR_MCASTRULE_ENTRY_ACTION, 1); /* flood */
+
+		addattr_nest_end(&req.n, nest);
+	}
+
+	/* Send; libnetlink will print kernel extack strings on failure */
+	if (rtnl_talk(&rth, &req.n, NULL) < 0)
+		return -1;
+
+	return 0;
+}
+
+static unsigned int mcast_rule_filter_index;
+
+static void print_mcast_rule_entry(struct rtattr *a, unsigned int ifindex)
+{
+	struct rtattr *tb[BR_MCASTRULE_ENTRY_MAX + 1];
+	char addrbuf[INET6_ADDRSTRLEN];
+	const void *grp = NULL;
+	int af = AF_UNSPEC;
+	const char *dev = ll_index_to_name(ifindex);
+
+	parse_rtattr_flags(tb, BR_MCASTRULE_ENTRY_MAX, RTA_DATA(a),
+			RTA_PAYLOAD(a), NLA_F_NESTED);
+
+	if (tb[BR_MCASTRULE_ENTRY_GROUP]) {
+		int glen = RTA_PAYLOAD(tb[BR_MCASTRULE_ENTRY_GROUP]);
+		grp = RTA_DATA(tb[BR_MCASTRULE_ENTRY_GROUP]);
+		if (glen == 4)
+			af = AF_INET;
+		else if (glen == 16)
+			af = AF_INET6;
+	}
+
+	/* Only "flood" action supported at the moment; default to flood if missing */
+	/* action value 1 == flood */
+	/* Print one line: dev X group G action flood */
+	if (grp && af != AF_UNSPEC) {
+		const char *astr = inet_ntop(af, grp, addrbuf, sizeof(addrbuf));
+		if (!astr)
+			astr = "(invalid)";
+		printf("dev %s group %s action flood\n", dev ? dev : "(unknown)", astr);
+	}
+}
+
+static int print_mcast_rule_dump(struct nlmsghdr *n, void *arg)
+{
+	struct br_mcast_rule_msg *hdr = NLMSG_DATA(n);
+	struct rtattr *a;
+	int rem;
+
+	/* Accept both RTM_GETMCASTRULE and RTM_NEWMCASTRULE in dump */
+	if (n->nlmsg_type != RTM_GETMCASTRULE &&
+			n->nlmsg_type != RTM_NEWMCASTRULE &&
+			n->nlmsg_type != RTM_DELMCASTRULE) {
+		fprintf(stderr,
+				"Not RTM_GETMCASTRULE/RTM_NEWMCASTRULE/RTM_DELMCASTRULE: %08x %08x %08x\n",
+				n->nlmsg_len, n->nlmsg_type, n->nlmsg_flags);
+		return 0;
+	}
+
+	/* Filter by device if requested */
+	if (mcast_rule_filter_index && mcast_rule_filter_index != hdr->ifindex)
+		return 0;
+
+	rem = n->nlmsg_len - NLMSG_LENGTH(sizeof(*hdr));
+	if (rem < 0) {
+		fprintf(stderr, "BUG: wrong nlmsg len %d\n", rem);
+		return -1;
+	}
+	for (a = (struct rtattr *)(((char *)hdr) + NLMSG_ALIGN(sizeof(*hdr)));
+			RTA_OK(a, rem);
+			a = RTA_NEXT(a, rem)) {
+		unsigned short rta_type = a->rta_type & NLA_TYPE_MASK;
+
+		if (rta_type > BR_MCASTRULE_MAX)
+			continue;
+
+		switch (rta_type) {
+			case BR_MCASTRULE_ENTRY:
+				print_mcast_rule_entry(a, hdr->ifindex);
+				break;
+			default:
+				break;
+		}
+	}
+
+	return 0;
+}
+
+static int mcast_rule_show(int argc, char **argv)
+{
+	char *filter_dev = NULL;
+	struct br_mcast_rule_msg req = {
+		.family  = PF_BRIDGE,
+		.reserved1 = 0,
+		.reserved2 = 0,
+		.ifindex = 0,
+	};
+
+	while (argc > 0) {
+		if (strcmp(*argv, "dev") == 0) {
+			NEXT_ARG();
+			if (filter_dev)
+				duparg("dev", *argv);
+			filter_dev = *argv;
+		} else if (matches(*argv, "help") == 0) {
+			mcast_rule_usage();
+		} else {
+			invarg("Unknown argument", *argv);
+		}
+		argc--; argv++;
+	}
+
+	if (filter_dev) {
+		mcast_rule_filter_index = ll_name_to_index(filter_dev);
+		if (!mcast_rule_filter_index)
+			return nodev(filter_dev);
+	} else {
+		mcast_rule_filter_index = 0;
+	}
+
+	/* Send dump request and print rules */
+	if (rtnl_dump_request(&rth, RTM_GETMCASTRULE, &req, sizeof(req)) < 0) {
+		perror("Cannot send dump request");
+		return -1;
+	}
+	if (rtnl_dump_filter(&rth, print_mcast_rule_dump, stdout) < 0) {
+		fprintf(stderr, "Dump terminated\n");
+		return -1;
+	}
+
+	fflush(stdout);
+	return 0;
+}
+
+int do_mcast_rule(int argc, char **argv)
+{
+	ll_init_map(&rth);
+	timestamp = 0;
+
+	if (argc > 0) {
+		if (matches(*argv, "add") == 0)
+			return mcast_rule_modify(RTM_NEWMCASTRULE, argc - 1, argv + 1);
+		if (matches(*argv, "del") == 0 ||
+				matches(*argv, "delete") == 0)
+			return mcast_rule_modify(RTM_DELMCASTRULE, argc - 1, argv + 1);
+		if (matches(*argv, "show") == 0 ||
+				matches(*argv, "lst") == 0 ||
+				matches(*argv, "list") == 0)
+			return mcast_rule_show(argc - 1, argv + 1);
+		if (matches(*argv, "help") == 0)
+			mcast_rule_usage();
+	}
+
+	fprintf(stderr, "Command \"%s\" is unknown, try \"bridge mcast-rule help\".\n",
+			argc > 0 ? *argv : "");
+	return -1;
+}
