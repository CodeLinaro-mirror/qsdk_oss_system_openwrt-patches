From 95c7aa7d911178bf94433e422ca26530d674a055 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Mon, 18 Nov 2024 16:56:13 +0530
Subject: [PATCH] QSDK:CP: ucode: add support for nl80211 vif radio mask

Used for multi-radio support

patch-dependency: None
patch-work: None

Link: https://github.com/openwrt/openwrt/commit/5db27664bc1ccbdbf2f80c8517d1b16bcfe6b626

Signed-off-by: Felix Fietkau <nbd@nbd.name>
Signed-off-by: Rajat Soni <quic_rajson@quicinc.com>
---
 include/linux/nl80211.h | 4 ++++
 lib/nl80211.c           | 3 ++-
 2 files changed, 6 insertions(+), 1 deletion(-)

--- a/lib/nl80211.c
+++ b/lib/nl80211.c
@@ -848,7 +848,7 @@ static const uc_nl_nested_spec_t nl80211
 
 static const uc_nl_nested_spec_t nl80211_msg = {
 	.headsize = 0,
-	.nattrs = 129,
+	.nattrs = 130,
 	.attrs = {
 		{ NL80211_ATTR_4ADDR, "4addr", DT_U8, 0, NULL },
 		{ NL80211_ATTR_AIRTIME_WEIGHT, "airtime_weight", DT_U16, 0, NULL },
@@ -978,6 +978,7 @@ static const uc_nl_nested_spec_t nl80211
 		{ NL80211_ATTR_MAX_AP_ASSOC_STA, "max_ap_assoc", DT_U16, 0, NULL },
 		{ NL80211_ATTR_SURVEY_INFO, "survey_info", DT_NESTED, 0, &nl80211_survey_info_nla },
 		{ NL80211_ATTR_WIPHY_RADIOS, "radios", DT_NESTED, DF_MULTIPLE|DF_AUTOIDX, &nl80211_wiphy_radio_nla },
+		{ NL80211_ATTR_VIF_RADIO_MASK, "vif_radio_mask", DT_U32, 0, NULL },
 		{ NL80211_ATTR_MULTI_HW_MACS, "multi_hw_macs", DT_NESTED, DF_MULTIPLE|DF_AUTOIDX, &nl80211_attr_multi_hw_macs },
 	}
 };
