config settings 'settings'
	# -------------------------------------------------------------------------
	# Service control
	# -------------------------------------------------------------------------
	option enabled '1'

	# -------------------------------------------------------------------------
	# Network interface configuration
	# -------------------------------------------------------------------------
	# Physical WAN interface used by ptp4l (must have PTP hardware clock support)
	option interface 'eth0'

	# UCI name of the WAN interface (used by procd interface trigger to detect
	# when the WAN interface comes up and acquires an IP address)
	option wan_uci_name 'wan'

	# -------------------------------------------------------------------------
	# Firewall settings
	# -------------------------------------------------------------------------
	# Allow PTP Ethernet frames (EtherType 0x88F7) Layer 2
	option layer2 '1'

	# Allow PTP UDP traffic (ports 319/320) Layer 3
	option layer3 '1'

	# Allow PTP IPv6 multicast (ff02::6b) in addition to IPv4 (224.0.1.129)
	option ipv6 '1'

	# Syslog verbosity level (0=emergency .. 7=debug, default 6=info)
	option log_level '6'

	# -------------------------------------------------------------------------
	# PTP daemon control
	# -------------------------------------------------------------------------
	# Run ptp4l on the WAN interface (slave mode) to sync eth0 PHC from
	# an external PTP grandmaster.  Starts only after WAN acquires an IP.
	option run_ptp4l '0'

	# Run ts2phc to copy time from the eth0 PHC (synced by ptp4l) to the
	# XGMAC PHC.  The XGMAC device is auto-detected via /sys/class/ptp/*/clock_name.
	# Prefers a device whose associated interface has operstate == "up".
	option run_ts2phc '0'

	# Run phc2sys to sync the system clock (CLOCK_REALTIME) from the XGMAC PHC.
	# If ts2phc is disabled, phc2sys syncs directly from the eth0 PHC instead.
	option run_phc2sys '0'

	# Run ptp4l in slave-only mode (recommended when syncing from an upstream master)
	option slave_mode '1'

	# -------------------------------------------------------------------------
	# Clock step threshold
	# -------------------------------------------------------------------------
	# When the measured offset between the local clock and the master exceeds
	# this value (in seconds), the clock is stepped (jumped) immediately instead
	# of being slewed gradually.  This prevents slow convergence after jitter
	# spikes or link flaps.
	# Applies to: ptp4l (via generated config file) and phc2sys (-S flag).
	# Set to '0' to disable stepping after the initial sync (linuxptp default).
	option step_threshold '0.128'

	# -------------------------------------------------------------------------
	# PHC device overrides (optional leave commented to use auto-detection)
	# -------------------------------------------------------------------------
	# By default the init script auto-detects every /dev/ptpX device:
	#   ptp4l PHC    : derived from 'interface' via ethtool -T
	#   ts2phc source: same as ptp4l PHC (the clock synced by ptp4l)
	#   ts2phc dest  : scanned from /sys/class/ptp/*/clock_name (looks for "xgmac")
	#   phc2sys src  : same as ts2phc destination (or ptp4l PHC if ts2phc disabled)
	#
	# Set any of the options below to pin a specific /dev/ptpX and bypass
	# auto-detection for that daemon.

	# Explicit PHC device for ptp4l (appended as -p /dev/ptpX).
	# Leave commented to auto-detect from 'interface' via ethtool -T.
	#option ptp4l_phc_dev '/dev/ptp0'

	# Source (master) PHC for ts2phc the clock already synced by ptp4l.
	# Leave commented to auto-detect from 'interface' via ethtool -T.
	#option ts2phc_src_phc '/dev/ptp0'

	# Destination (slave) PHC for ts2phc the XGMAC / internal hardware clock.
	# Leave commented to auto-detect by scanning /sys/class/ptp/*/clock_name
	# for a name containing "xgmac".
	#option ts2phc_dst_phc '/dev/ptp1'

	# Source PHC for phc2sys (synced to CLOCK_REALTIME).
	# Leave commented to use the ts2phc destination PHC (or the ptp4l PHC when
	# ts2phc is disabled).
	#option phc2sys_src_phc '/dev/ptp1'

	# -------------------------------------------------------------------------
	# WiFi PHC sync (ath12k_ptp devices)
	# -------------------------------------------------------------------------
	# Run a separate ts2phc instance to sync all ath12k_ptp WiFi PHC devices
	# from a configurable source PHC.  The WiFi ts2phc is started after the
	# main ts2phc has synced the XGMAC PHC, so the source is already accurate
	# regardless of which PHC is chosen as the WiFi source.
	#
	# The WiFi ts2phc instance is tracked by a separate PID file
	# (/var/run/ts2phc-wifi.pid) so it never interferes with the main ts2phc.
	option run_ts2phc_wifi '0'

	# Source PHC for the WiFi ts2phc instance.
	# Leave unset to auto-detect: the first /dev/ptpX whose clock_name does
	# NOT contain "ath12k_ptp" is used (typically the XGMAC or eth0 PHC).
	#option ts2phc_wifi_src_phc '/dev/ptp1'

	# Destination PHC(s) for the WiFi ts2phc instance (space-separated list
	# for boards with multiple WiFi radios, e.g. '/dev/ptp2 /dev/ptp3').
	# Leave unset to auto-detect all devices whose clock_name contains
	# "ath12k_ptp" by scanning /sys/class/ptp/*/clock_name at startup.
	#option ts2phc_wifi_dst_phc '/dev/ptp2'

	# Extra arguments appended to the WiFi ts2phc command line.
	#option ts2phc_wifi_opts '-l 7'

	# -------------------------------------------------------------------------
	# Optional: custom extra arguments for each daemon
	# -------------------------------------------------------------------------
	# Uncomment and set as needed.  Arguments are appended to the daemon command line.
	#
	# Examples:
	#   option ptp4l_opts  '-f /etc/ptp4l.conf'
	#   option ts2phc_opts '-l 7'
	#   option phc2sys_opts '-O 0 -R 8'

# =============================================================================
# Synchronization chain (auto-configured at runtime):
#
#   External PTP Master
#     --> ptp4l  -i eth0 -m -s          (slave mode, syncs eth0 PHC)
#     --> ts2phc -s /dev/ptpN -c /dev/ptpM -m
#                  /dev/ptpN = eth0 PHC (source, synced by ptp4l)
#                  /dev/ptpM = XGMAC PHC (destination, auto-detected)
#     --> ts2phc-wifi -s /dev/ptpX -c /dev/ptpY [-c /dev/ptpZ ...] -m
#                  /dev/ptpX = WiFi source PHC (auto-detected or overridden)
#                  /dev/ptpY[Z...] = ath12k_ptp WiFi PHC(s) (auto-detected)
#                  (started after main ts2phc has synced the XGMAC PHC)
#     --> phc2sys -s /dev/ptpM -c CLOCK_REALTIME -w -m
#                                        (XGMAC PHC -> system clock)
#
# The XGMAC PHC (/dev/ptpM) is auto-detected by scanning
# /sys/class/ptp/*/clock_name for a name containing "xgmac".
# The ath12k_ptp WiFi PHC(s) are auto-detected by scanning
# /sys/class/ptp/*/clock_name for names containing "ath12k_ptp".
#
# To disable any daemon in the chain, set its run_* option to '0'.
# Example: firewall rules only, no daemons:
#   option run_ptp4l       '0'
#   option run_ts2phc      '0'
#   option run_ts2phc_wifi '0'
#   option run_phc2sys     '0'
# =============================================================================
