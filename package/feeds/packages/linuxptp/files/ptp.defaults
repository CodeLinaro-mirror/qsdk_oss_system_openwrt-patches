# SPDX-License-Identifier: ISC
#
# PTP uci-defaults script
# Runs once at first boot (via /etc/uci-defaults/99-ptp).
# Registers /etc/firewall.d/ptp as a fw3/fw4 firewall include so that
# PTP traffic rules are applied on every firewall start/reload.

uci -q get firewall.ptp > /dev/null 2>&1 || {
	uci set firewall.ptp=include
	uci set firewall.ptp.type='script'
	uci set firewall.ptp.path='/etc/firewall.d/ptp'
	uci commit firewall
}

exit 0
