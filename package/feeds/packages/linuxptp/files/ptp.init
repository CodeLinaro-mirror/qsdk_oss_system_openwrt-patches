#!/bin/sh /etc/rc.common
#
# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
# SPDX-License-Identifier: ISC
#
# PTP (Precision Time Protocol) init script for OpenWrt
#
# Sync chain (ap mode, default):
#   External PTP Master
#     -> ptp4l  (WAN/eth0, slave mode)       -- syncs eth0 PHC from external master
#     -> ts2phc (eth0 PHC -> linked-up XGMAC and external Ethernet PHY PHCs)
#     -> phc2sys (XGMAC PHC -> system clock) -- keeps system time in sync
#
# Repeater mode (option mode 'repeater'):
#   ath12k_ptp WiFi PHC (synced to the upstream AP by the WiFi driver)
#     -> ts2phc (ath12k_ptp PHC -> linked-up XGMAC and external Ethernet
#        PHY PHCs)
#     -> phc2sys (XGMAC PHC -> system clock)
#   ptp4l and the WiFi ts2phc instance are not used in this mode.
#
# ptp4l is started as a direct procd instance.
# ts2phc and phc2sys are started by /usr/sbin/ptp-sequencer (a second procd
# instance) which waits for ptp4l to reach s2 before starting ts2phc, and
# then waits for the XGMAC PHC to settle before starting phc2sys.  This
# prevents phc2sys from trying to step the system clock by decades when the
# XGMAC PHC has not yet been set.
#
# Firewall rules for PTP traffic are managed separately via
# /etc/firewall.d/ptp (registered as a fw3/fw4 include in /etc/config/firewall
# by /etc/uci-defaults/99-ptp at first boot).
#
# "ptp_disabled" in the bootargs skips the service at boot.

START=99
STOP=10
USE_PROCD=1

PTP4L_BIN=/usr/sbin/ptp4l
PTP_SEQUENCER_BIN=/usr/sbin/ptp-sequencer
PTP4L_CONF=/tmp/ptp4l-auto.conf

# ---------------------------------------------------------------------------
# Helper: enumerate all network interfaces with PTP hardware clock capability
# ---------------------------------------------------------------------------
get_ptp_capable_interfaces() {
	local result=""
	local iface
	for iface in $(ls /sys/class/net/ 2>/dev/null); do
		[ "$iface" = "lo" ] && continue
		if ethtool -T "$iface" 2>/dev/null | grep -qE "PTP Hardware Clock: [0-9]+"; then
			result="$result $iface"
		fi
	done
	echo "$result"
}

# ---------------------------------------------------------------------------
# Helper: get the PHC device number for a given network interface
# Returns just the numeric index (e.g. "0" for /dev/ptp0).
# ---------------------------------------------------------------------------
get_phc_num_for_iface() {
	local iface="$1"
	ethtool -T "$iface" 2>/dev/null \
		| grep "PTP Hardware Clock" \
		| grep -o '[0-9]\+' \
		| head -1
}

# ---------------------------------------------------------------------------
# Helper: find all ath12k_ptp PHC devices (WiFi PTP clocks)
#
# Scans /sys/class/ptp/ptp*/clock_name and prints one /dev/ptpX per line for
# every device whose clock_name contains the string "ath12k_ptp".
# Used to auto-detect WiFi PHC destinations for the ts2phc_wifi instance.
# ---------------------------------------------------------------------------
find_ath12k_ptp_devs() {
	local ptp_sysfs clock_name

	for ptp_sysfs in /sys/class/ptp/ptp*; do
		[ -d "$ptp_sysfs" ] || continue
		[ -f "$ptp_sysfs/clock_name" ] || continue
		clock_name=$(cat "$ptp_sysfs/clock_name" 2>/dev/null)
		case "$clock_name" in
			*ath12k_ptp*)
				echo "/dev/$(basename "$ptp_sysfs")" ;;
		esac
	done
}

# ---------------------------------------------------------------------------
# Helper: find the first non-ath12k_ptp PHC device
#
# Returns the first /dev/ptpX whose clock_name does NOT contain "ath12k_ptp".
# Used as the auto-detected source PHC for the WiFi ts2phc instance when
# ts2phc_wifi_src_phc is not explicitly set in UCI.
# ---------------------------------------------------------------------------
find_non_ath12k_ptp_dev() {
	local ptp_sysfs clock_name

	for ptp_sysfs in /sys/class/ptp/ptp*; do
		[ -d "$ptp_sysfs" ] || continue
		[ -f "$ptp_sysfs/clock_name" ] || continue
		clock_name=$(cat "$ptp_sysfs/clock_name" 2>/dev/null)
		case "$clock_name" in
			*ath12k_ptp*) continue ;;
		esac
		echo "/dev/$(basename "$ptp_sysfs")"
		return 0
	done
	return 1
}

# ---------------------------------------------------------------------------
# Helper: print the netdev that owns a PHC
#
# Usage: get_netdev_for_phc /dev/ptpX
#
# XGMAC PHCs are registered on the nss-dp platform device, so the netdev is
# listed under /sys/class/ptp/ptpX/device/net/.  Ethernet PHY PHCs are
# registered on the MDIO device, whose attached_dev link points to the
# netdev.  Prints nothing if no netdev is found.
# ---------------------------------------------------------------------------
get_netdev_for_phc() {
	local ptp_sysfs="/sys/class/ptp/${1#/dev/}"
	local net_sysfs

	for net_sysfs in "$ptp_sysfs"/device/net/*; do
		[ -d "$net_sysfs" ] || continue
		basename "$net_sysfs"
		return 0
	done

	if [ -L "$ptp_sysfs/device/attached_dev" ]; then
		basename "$(readlink "$ptp_sysfs/device/attached_dev")"
		return 0
	fi

	return 1
}

# ---------------------------------------------------------------------------
# Helper: find all linked-up Ethernet PHC devices (XGMAC and external PHY)
#
# Usage: find_eth_ptp_devs [exclude PHC]
#
# Prints one /dev/ptpX per line for every device whose clock_name contains
# "xgmac" (nss-dp XGMAC) or is "qca8xxx_phc" (external QCA8xxx PHY) and
# whose netdev operstate is up.  The PHC given as argument (the ts2phc
# source) is skipped.  Used as the ts2phc destinations.  The IPQ52xx
# internal PHY PHC ("internal_phc") is never a destination; it can only be
# the ts2phc source.
# ---------------------------------------------------------------------------
find_eth_ptp_devs() {
	local exclude="$1"
	local ptp_sysfs dev clock_name iface operstate

	for ptp_sysfs in /sys/class/ptp/ptp*; do
		[ -d "$ptp_sysfs" ] || continue
		[ -f "$ptp_sysfs/clock_name" ] || continue
		dev="/dev/$(basename "$ptp_sysfs")"
		[ "$dev" = "$exclude" ] && continue
		clock_name=$(cat "$ptp_sysfs/clock_name" 2>/dev/null)
		case "$clock_name" in
			*xgmac*|*XGMAC*|qca8xxx_phc) ;;
			*) continue ;;
		esac

		iface=$(get_netdev_for_phc "$dev")
		operstate=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null)
		logger -t ptp -p info \
			"Ethernet PHC $dev (clock: $clock_name): interface ${iface:-none} is ${operstate:-unknown}"
		[ "$operstate" = "up" ] && echo "$dev"
	done
}

# ---------------------------------------------------------------------------
# Helper: check whether a network interface has an IPv4 address
# ---------------------------------------------------------------------------
iface_has_ip() {
	local iface="$1"
	ip addr show "$iface" 2>/dev/null | grep -q "inet "
}

# ---------------------------------------------------------------------------
# Helper: configure the XGMAC PPS input mux where the SoC has one (ipq5210).
#
# The XGMAC PPS input mux must be set before ts2phc starts.
# The mux selects which PPS is fed to the XGMAC only; Ethernet PHYs have
# their own PPS connection, so it is only configured when an XGMAC PHC is
# one of the ts2phc destinations.
# The mux is controlled via debugfs, which qca-nss-dp only creates on SoCs
# that have the mux:
#   /sys/kernel/debug/qca-nss-dp/ptp/pps_in_source
#
# The correct value is derived from the ts2phc source PHC clock_name:
#   clock_name = "internal_phc"  ->  pps_in_source = "internal_phy"
#   clock_name = "PON_PTP"       ->  pps_in_source = "pon_mac"
#   anything else                ->  pps_in_source = "external_phy" (default)
# In ap mode the source is the PHC ptp4l runs on, so ptp4l on the internal
# PHY selects "internal_phy" and ptp4l on an external PHY "external_phy".
# In repeater mode the ath12k_ptp WiFi PPS enters via GPIO, the same as an
# external PHY, so it selects "external_phy" as well.
#
# SoCs without the mux (e.g. ipq9650) do not create the file and need no
# configuration.
# A manual override is available via the UCI option pps_in_source.
# ---------------------------------------------------------------------------
configure_pps_source() {
	local src_phc="$1"
	local pps_in_source_override="$2"
	local ptp_num clock_name pps_source
	local debugfs="/sys/kernel/debug/qca-nss-dp/ptp/pps_in_source"

	# No PPS input mux on this SoC
	[ -f "$debugfs" ] || return 0

	# Manual override via UCI pps_in_source option
	if [ -n "$pps_in_source_override" ]; then
		echo "$pps_in_source_override" > "$debugfs"
		logger -t ptp -p info \
			"PPS source set to $pps_in_source_override (manual override)"
		return 0
	fi

	# Auto-detect from source PHC clock_name
	ptp_num="${src_phc#/dev/ptp}"
	clock_name=$(cat "/sys/class/ptp/ptp${ptp_num}/clock_name" 2>/dev/null)

	case "$clock_name" in
		internal_phc)
			pps_source="internal_phy" ;;
		PON_PTP)
			pps_source="pon_mac" ;;
		*)
			pps_source="external_phy" ;;
	esac

	echo "$pps_source" > "$debugfs"
	logger -t ptp -p info \
		"PPS source set to $pps_source (auto-detected from clock_name=$clock_name)"
}

# ---------------------------------------------------------------------------
# UCI section validator
# ---------------------------------------------------------------------------
validate_ptp_section() {
	uci_validate_section ptp settings "${1}" \
		'enabled:bool:1' \
		'mode:or("ap","repeater"):ap' \
		'interface:string:eth0' \
		'wan_uci_name:string:wan' \
		'log_level:range(0,7):6' \
		'daemon_log:bool:1' \
		'run_ptp4l:bool:1' \
		'run_ts2phc:bool:1' \
		'run_phc2sys:bool:1' \
		'run_ts2phc_wifi:bool:0' \
		'ptp4l_opts:string' \
		'ts2phc_opts:string' \
		'phc2sys_opts:string' \
		'ts2phc_wifi_src_phc:string' \
		'ts2phc_wifi_dst_phc:string' \
		'ts2phc_wifi_opts:string' \
		'slave_mode:bool:1' \
		'ptp4l_phc_dev:string' \
		'ts2phc_src_phc:string' \
		'ts2phc_dst_phc:string' \
		'phc2sys_src_phc:string' \
		'pps_in_source:string' \
		'step_threshold:string:0.128'
}

# ===========================================================================
# procd service management
# ===========================================================================

# Bootargs "ptp_disabled" skips the PTP service at boot; a manual
# "/etc/init.d/ptp start" still starts it
boot() {
	if grep -qw ptp_disabled /proc/cmdline 2>/dev/null; then
		logger -t ptp -p info \
			"ptp_disabled in bootargs; PTP service not started at boot"
		return 0
	fi
	start "$@"
}

start_service() {
	local enabled mode interface wan_uci_name daemon_log
	local run_ptp4l run_ts2phc run_phc2sys run_ts2phc_wifi
	local ptp4l_opts ts2phc_opts phc2sys_opts ts2phc_wifi_src_phc ts2phc_wifi_dst_phc ts2phc_wifi_opts slave_mode
	local ptp4l_phc_dev ts2phc_src_phc ts2phc_dst_phc phc2sys_src_phc pps_in_source step_threshold

	# ---- Load UCI configuration ----
	config_load ptp
	config_get enabled        settings enabled        1
	config_get mode           settings mode           "ap"
	config_get interface      settings interface      "eth0"
	config_get wan_uci_name   settings wan_uci_name   "wan"
	config_get daemon_log     settings daemon_log     1
	config_get run_ptp4l           settings run_ptp4l           1
	config_get run_ts2phc          settings run_ts2phc          1
	config_get run_phc2sys         settings run_phc2sys         1
	config_get run_ts2phc_wifi     settings run_ts2phc_wifi     0
	config_get ptp4l_opts          settings ptp4l_opts          ""
	config_get ts2phc_opts         settings ts2phc_opts         ""
	config_get phc2sys_opts        settings phc2sys_opts        ""
	config_get ts2phc_wifi_src_phc settings ts2phc_wifi_src_phc ""
	config_get ts2phc_wifi_dst_phc settings ts2phc_wifi_dst_phc ""
	config_get ts2phc_wifi_opts    settings ts2phc_wifi_opts    ""
	config_get slave_mode          settings slave_mode          1
	config_get ptp4l_phc_dev   settings ptp4l_phc_dev   ""
	config_get ts2phc_src_phc  settings ts2phc_src_phc  ""
	config_get ts2phc_dst_phc  settings ts2phc_dst_phc  ""
	config_get phc2sys_src_phc settings phc2sys_src_phc ""
	config_get pps_in_source   settings pps_in_source   ""
	config_get step_threshold  settings step_threshold  "0.128"

	[ "$enabled" != "1" ] && {
		logger -t ptp -p info "PTP service is disabled"
		return 0
	}

	# In repeater mode the ath12k_ptp WiFi PHC is the time reference: it is
	# kept in sync with the upstream AP by the WiFi driver, so ptp4l is not
	# needed, and the WiFi ts2phc (which syncs the WiFi PHC) must not run.
	if [ "$mode" = "repeater" ]; then
		[ "$run_ptp4l" = "1" ] && logger -t ptp -p info \
			"Repeater mode: ignoring run_ptp4l"
		[ "$run_ts2phc_wifi" = "1" ] && logger -t ptp -p info \
			"Repeater mode: ignoring run_ts2phc_wifi"
		run_ptp4l=0
		run_ts2phc_wifi=0
	fi

	if [ "$run_ptp4l" != "1" ] && [ "$run_ts2phc" != "1" ] && \
	   [ "$run_phc2sys" != "1" ] && [ "$run_ts2phc_wifi" != "1" ]; then
		logger -t ptp -p info "No PTP daemon enabled (run_* = 0); PTP service idle"
		return 0
	fi

	# Per-daemon state for the final summary: disabled (run_* = 0), skipped
	# (enabled but not started, the reason is logged) or started
	local ptp4l_state=disabled ts2phc_state=disabled
	local phc2sys_state=disabled ts2phc_wifi_state=disabled
	[ "$run_ptp4l" = "1" ] && ptp4l_state=skipped
	[ "$run_ts2phc" = "1" ] && ts2phc_state=skipped
	[ "$run_phc2sys" = "1" ] && phc2sys_state=skipped
	[ "$run_ts2phc_wifi" = "1" ] && ts2phc_wifi_state=skipped

	# Guard against double-start: the service_triggers() interface trigger fires
	# when the WAN interface comes up (shortly after boot), which can cause a
	# second start_service() call while the first ptp4l is still initialising.
	# Skip the restart if ptp4l is already running to avoid killing a healthy
	# sequencer mid-run.
	if killall -0 ptp4l 2>/dev/null; then
		logger -t ptp -p info \
			"PTP already running (ptp4l detected); skipping redundant start"
		return 0
	fi

	logger -t ptp -p info "=== PTP service starting (mode: $mode, WAN interface: $interface) ==="
	[ "$daemon_log" = "1" ] || logger -t ptp -p info \
		"Daemon logging disabled: ptp4l/ts2phc/phc2sys output is not sent to syslog"

	# ---- Enumerate PTP-capable interfaces ----
	local ptp_ifaces
	ptp_ifaces=$(get_ptp_capable_interfaces)
	if [ -n "$ptp_ifaces" ]; then
		logger -t ptp -p info "PTP-capable interfaces detected:$ptp_ifaces"
	else
		logger -t ptp -p warn "No PTP-capable interfaces found via ethtool -T"
	fi

	# ---- Check WAN interface has an IP address (only required for ptp4l,
	# which needs UDP/IP transport to reach the master; ts2phc/phc2sys work
	# directly on hardware PHC devices and don't depend on interface IP) ----
	if [ "$run_ptp4l" = "1" ] && ! iface_has_ip "$interface"; then
		logger -t ptp -p info \
			"Interface $interface has no IP yet; PTP daemons will start when WAN is up"
		return 0
	fi
	[ "$run_ptp4l" = "1" ] && \
		logger -t ptp -p info "Interface $interface has IP; proceeding with PTP daemon startup"

	# =========================================================================
	# Step 1: Register ptp4l as a direct procd instance
	# =========================================================================
	if [ "$run_ptp4l" = "1" ] && [ -x "$PTP4L_BIN" ]; then
		local ptp4l_phc_num
		ptp4l_phc_num=$(get_phc_num_for_iface "$interface")

		if [ -n "$ptp4l_phc_dev" ]; then
			logger -t ptp -p info \
				"Starting ptp4l on $interface (PHC override: $ptp4l_phc_dev, slave mode)"
		elif [ -n "$ptp4l_phc_num" ]; then
			logger -t ptp -p info \
				"Starting ptp4l on $interface (PHC: /dev/ptp${ptp4l_phc_num}, slave mode)"
		else
			logger -t ptp -p warn \
				"Starting ptp4l on $interface (no hardware PHC detected, software timestamping)"
		fi

		cat > "$PTP4L_CONF" << EOF
# Auto-generated by ptp init script
[global]
step_threshold  $step_threshold
EOF
		logger -t ptp -p info \
			"ptp4l config written to $PTP4L_CONF (step_threshold=$step_threshold)"

		procd_open_instance ptp4l
		procd_set_param command "$PTP4L_BIN"
		procd_append_param command -i "$interface"
		procd_append_param command -f "$PTP4L_CONF"
		# With daemon logging disabled, -q keeps ptp4l out of syslog and
		# dropping -m leaves nothing on stdout; the sequencer monitors
		# ptp4l via pmc, not its log output.
		if [ "$daemon_log" = "1" ]; then
			procd_append_param command -m
		else
			procd_append_param command -q
		fi
		[ "$slave_mode" = "1" ] && procd_append_param command -s
		[ -n "$ptp4l_phc_dev" ] && procd_append_param command -p "$ptp4l_phc_dev"
		[ -n "$ptp4l_opts" ] && procd_append_param command $ptp4l_opts
		procd_set_param respawn 3600 5 0
		procd_set_param stdout "$daemon_log"
		procd_set_param stderr "$daemon_log"
		procd_close_instance

		logger -t ptp -p info "ptp4l instance registered"
		ptp4l_state=started
	fi

	# =========================================================================
	# Step 2: Resolve ts2phc PHC devices
	#
	# ts2phc is invoked as: ts2phc -s <src> -c <dst1> [-c <dst2> ...] -m
	# No config file is needed; source and destination(s) are passed on the
	# command line via --ts2phc-src and --ts2phc-dst to the sequencer.
	# ts2phc_dst_phc may list several PHCs (space-separated); xgmac_phc then
	# holds that list.  Otherwise the destinations are all linked-up XGMAC
	# and external Ethernet PHY PHCs.  The source is the ptp4l PHC in ap
	# mode and the ath12k_ptp PHC in repeater mode.
	# =========================================================================
	local ts2phc_ready=0
	local src_phc="" xgmac_phc="" dst dsts=""

	if [ "$run_ts2phc" = "1" ] && [ -x /usr/sbin/ts2phc ]; then
		# Resolve source PHC
		if [ -n "$ts2phc_src_phc" ]; then
			src_phc="$ts2phc_src_phc"
			logger -t ptp -p info "ts2phc source PHC: $src_phc"
		elif [ "$mode" = "repeater" ]; then
			src_phc=$(find_ath12k_ptp_devs | head -1)
			if [ -z "$src_phc" ]; then
				logger -t ptp -p warn \
					"Skipping ts2phc: no ath12k_ptp PHC found (set ts2phc_src_phc to override)"
			else
				logger -t ptp -p info \
					"ts2phc source PHC: $src_phc (ath12k_ptp, repeater mode)"
			fi
		else
			local ptp4l_phc_num
			ptp4l_phc_num=$(get_phc_num_for_iface "$interface")
			if [ -z "$ptp4l_phc_num" ]; then
				logger -t ptp -p warn \
					"Skipping ts2phc: no hardware PHC found for $interface (set ts2phc_src_phc to override)"
			else
				src_phc="/dev/ptp${ptp4l_phc_num}"
			fi
		fi

		# Resolve destination PHC(s): every linked-up XGMAC and
		# external Ethernet PHY PHC other than the source, in both ap
		# and repeater mode
		if [ -n "$ts2phc_dst_phc" ]; then
			xgmac_phc="$ts2phc_dst_phc"
			logger -t ptp -p info "ts2phc destination PHC(s): $xgmac_phc"
		else
			xgmac_phc=$(find_eth_ptp_devs "$src_phc" | tr '\n' ' ')
			xgmac_phc="${xgmac_phc% }"
		fi

		# Drop any destination that is the source PHC itself
		for dst in $xgmac_phc; do
			if [ "$dst" = "$src_phc" ]; then
				logger -t ptp -p info \
					"Source and destination PHC are the same ($src_phc); not syncing it with ts2phc"
			else
				dsts="$dsts $dst"
			fi
		done
		dsts="${dsts# }"

		if [ -z "$src_phc" ]; then
			: # already logged
		elif [ -z "$xgmac_phc" ]; then
			logger -t ptp -p warn \
				"Skipping ts2phc: no destination PHC found (set ts2phc_dst_phc to override)"
		elif [ -z "$dsts" ]; then
			logger -t ptp -p info \
				"No destination PHC other than the source ($src_phc); ts2phc not needed"
		else
			xgmac_phc="$dsts"
			logger -t ptp -p info \
				"ts2phc: $src_phc -> $xgmac_phc"
			# Configure the XGMAC PPS input mux (ipq5210 only).  The mux
			# only feeds the XGMAC; Ethernet PHYs have their own PPS input,
			# so it is left alone when no XGMAC PHC is a destination.
			for dst in $xgmac_phc; do
				case "$(cat "/sys/class/ptp/${dst#/dev/}/clock_name" 2>/dev/null)" in
					*xgmac*|*XGMAC*)
						configure_pps_source "$src_phc" "$pps_in_source"
						break ;;
				esac
			done
			ts2phc_ready=1
		fi
	fi

	# =========================================================================
	# Step 2b: Resolve WiFi ts2phc PHC devices (ath12k_ptp)
	#
	# A separate ts2phc instance syncs one or more ath12k_ptp WiFi PHC devices
	# from a configurable source PHC (defaults to the first non-ath12k_ptp
	# device found in /sys/class/ptp/).  The WiFi ts2phc is started by the
	# ptp-chain sequencer after the main ts2phc has synced the XGMAC PHC,
	# ensuring the source is stable regardless of which PHC is chosen.
	# =========================================================================
	local ts2phc_wifi_ready=0
	local wifi_src_phc="" wifi_devs=""

	if [ "$run_ts2phc_wifi" = "1" ] && [ -x /usr/sbin/ts2phc ]; then
		# Resolve WiFi source PHC
		if [ -n "$ts2phc_wifi_src_phc" ]; then
			wifi_src_phc="$ts2phc_wifi_src_phc"
			logger -t ptp -p info \
				"ts2phc_wifi source PHC: $wifi_src_phc (override)"
		else
			wifi_src_phc=$(find_non_ath12k_ptp_dev)
			if [ -z "$wifi_src_phc" ]; then
				logger -t ptp -p warn \
					"Skipping ts2phc_wifi: no non-ath12k_ptp source PHC found (set ts2phc_wifi_src_phc to override)"
			else
				logger -t ptp -p info \
					"ts2phc_wifi source PHC: $wifi_src_phc (auto-detected)"
			fi
		fi

		# Resolve WiFi destination PHC(s)
		if [ -n "$ts2phc_wifi_dst_phc" ]; then
			wifi_devs="$ts2phc_wifi_dst_phc"
			logger -t ptp -p info \
				"ts2phc_wifi destination PHC(s): $wifi_devs (override)"
		else
			wifi_devs=$(find_ath12k_ptp_devs | tr '\n' ' ')
			wifi_devs="${wifi_devs% }"
			if [ -z "$wifi_devs" ]; then
				logger -t ptp -p warn \
					"Skipping ts2phc_wifi: no ath12k_ptp device found (set ts2phc_wifi_dst_phc to override)"
			else
				logger -t ptp -p info \
					"ts2phc_wifi destination PHC(s): $wifi_devs (auto-detected)"
			fi
		fi

		if [ -n "$wifi_src_phc" ] && [ -n "$wifi_devs" ]; then
			logger -t ptp -p info \
				"ts2phc_wifi: $wifi_src_phc -> $wifi_devs"
			ts2phc_wifi_ready=1
		fi
	fi

	# =========================================================================
	# Step 3: Resolve phc2sys source PHC
	# =========================================================================
	local phc2sys_src=""

	if [ "$run_phc2sys" = "1" ] && [ -x /usr/sbin/phc2sys ]; then
		if [ -n "$phc2sys_src_phc" ]; then
			phc2sys_src="$phc2sys_src_phc"
			logger -t ptp -p info "phc2sys source PHC: $phc2sys_src"
		elif [ "$ts2phc_ready" = "1" ]; then
			# ts2phc is running: sync from the XGMAC destination of the
			# ptp4l interface (ap mode), else the first XGMAC destination,
			# else the first destination if none is an XGMAC PHC
			local first_xgmac=""
			for dst in $xgmac_phc; do
				case "$(cat "/sys/class/ptp/${dst#/dev/}/clock_name" 2>/dev/null)" in
					*xgmac*|*XGMAC*) ;;
					*) continue ;;
				esac
				[ -z "$first_xgmac" ] && first_xgmac="$dst"
				if [ "$mode" != "repeater" ] && \
				   [ -d "/sys/class/ptp/${dst#/dev/}/device/net/$interface" ]; then
					phc2sys_src="$dst"
					break
				fi
			done
			[ -z "$phc2sys_src" ] && phc2sys_src="$first_xgmac"
			[ -z "$phc2sys_src" ] && phc2sys_src="${xgmac_phc%% *}"
			logger -t ptp -p info "phc2sys source PHC: $phc2sys_src"
		elif [ -n "$ts2phc_src_phc" ]; then
			phc2sys_src="$ts2phc_src_phc"
			logger -t ptp -p info "phc2sys using ts2phc_src_phc: $phc2sys_src"
		elif [ "$mode" = "repeater" ]; then
			# No ts2phc: sync directly from the ath12k_ptp PHC
			phc2sys_src=$(find_ath12k_ptp_devs | head -1)
		else
			# No ts2phc: sync directly from ptp4l's PHC
			local ptp4l_phc_num
			ptp4l_phc_num=$(get_phc_num_for_iface "$interface")
			[ -n "$ptp4l_phc_num" ] && phc2sys_src="/dev/ptp${ptp4l_phc_num}"
		fi

		if [ -z "$phc2sys_src" ]; then
			logger -t ptp -p warn \
				"Skipping phc2sys: no source PHC found (set phc2sys_src_phc to override)"
		fi
	fi

	# =========================================================================
	# Step 4: Register ptp-chain sequencer instance
	#
	# The sequencer waits for ptp4l s2, then starts ts2phc and phc2sys in
	# sequence.  This prevents phc2sys from stepping the clock by decades
	# when the XGMAC PHC has not yet been set.
	# =========================================================================
	if [ "$ts2phc_ready" = "1" ] || [ "$ts2phc_wifi_ready" = "1" ] || [ -n "$phc2sys_src" ]; then
		if [ ! -x "$PTP_SEQUENCER_BIN" ]; then
			logger -t ptp -p warn \
				"$PTP_SEQUENCER_BIN not found; ts2phc/phc2sys will not start"
		else
			logger -t ptp -p info "Registering ptp-chain sequencer instance"

			procd_open_instance ptp-chain
			procd_set_param command "$PTP_SEQUENCER_BIN"

			# Tell the sequencer whether ptp4l is part of the chain, so it
			# knows whether to wait for/monitor ptp4l sync at all (avoids a
			# pointless 300s stall and false "lost sync" restarts when
			# ptp4l isn't running, e.g. standalone ts2phc/phc2sys configs).
			[ "$run_ptp4l" = "1" ] && procd_append_param command --ptp4l-enabled

			# Keep ts2phc/phc2sys output out of syslog if requested
			[ "$daemon_log" = "1" ] || procd_append_param command --no-daemon-log

			# ts2phc args: pass source and destination(s) directly (no config file)
			if [ "$ts2phc_ready" = "1" ]; then
				procd_append_param command --ts2phc-src "$src_phc"
				for dst in $xgmac_phc; do
					procd_append_param command --ts2phc-dst "$dst"
				done
				[ -n "$ts2phc_opts" ] && \
					procd_append_param command --ts2phc-opts "$ts2phc_opts"
			fi

			# WiFi ts2phc args: separate ts2phc instance for ath12k_ptp devices
			if [ "$ts2phc_wifi_ready" = "1" ]; then
				procd_append_param command --ts2phc-wifi-src "$wifi_src_phc"
				for wifi_dev in $wifi_devs; do
					procd_append_param command --ts2phc-wifi-dst "$wifi_dev"
				done
				[ -n "$ts2phc_wifi_opts" ] && \
					procd_append_param command --ts2phc-wifi-opts "$ts2phc_wifi_opts"
			fi

			# phc2sys args
			if [ -n "$phc2sys_src" ]; then
				procd_append_param command --phc2sys-src "$phc2sys_src"
				procd_append_param command --phc2sys-step "$step_threshold"
				# The ath12k_ptp PHC runs on UTC, not TAI, so the
				# repeater chain needs no UTC-TAI correction
				[ "$mode" = "repeater" ] && \
					procd_append_param command --phc2sys-utc-offset 0
				[ -n "$phc2sys_opts" ] && \
					procd_append_param command --phc2sys-opts "$phc2sys_opts"
			fi

			procd_set_param respawn 3600 5 0
			procd_set_param term_timeout 15
			# No stdout/stderr capture: ts2phc and phc2sys use -m to log
			# directly to syslog with their own process name as the tag.
			# Capturing stdout here would produce duplicate log lines.
			procd_close_instance

			logger -t ptp -p info "ptp-chain sequencer instance registered"
			[ "$ts2phc_ready" = "1" ] && ts2phc_state=started
			[ "$ts2phc_wifi_ready" = "1" ] && ts2phc_wifi_state=started
			[ -n "$phc2sys_src" ] && phc2sys_state=started
		fi
	fi

	local summary="ptp4l=$ptp4l_state ts2phc=$ts2phc_state phc2sys=$phc2sys_state"
	[ "$run_ts2phc_wifi" = "1" ] && summary="$summary ts2phc-wifi=$ts2phc_wifi_state"
	case "$summary" in
		*=started*)
			logger -t ptp -p info "=== PTP service: $summary ===" ;;
		*)
			logger -t ptp -p warn "=== PTP service: $summary ===" ;;
	esac
}

stop_service() {
	logger -t ptp -p info "Stopping PTP service"
	rm -f "$PTP4L_CONF"
	logger -t ptp -p info "PTP service stopped"
}

reload_service() {
	logger -t ptp -p info "Reloading PTP service"
	stop_service
	start_service
}

service_triggers() {
	local mode interface wan_uci_name run_ptp4l

	config_load ptp
	config_get mode         settings mode         "ap"
	config_get interface    settings interface    "eth0"
	config_get wan_uci_name settings wan_uci_name "wan"
	config_get run_ptp4l    settings run_ptp4l    1

	procd_add_reload_trigger "ptp"
	procd_add_reload_trigger "network"

	# Only ptp4l waits for the WAN IP; no ptp4l runs in repeater mode
	[ "$run_ptp4l" = "1" ] && [ "$mode" != "repeater" ] && \
		procd_add_interface_trigger "interface.*" "$wan_uci_name" /etc/init.d/ptp restart

	procd_open_validate
	validate_ptp_section
	procd_close_validate
}
