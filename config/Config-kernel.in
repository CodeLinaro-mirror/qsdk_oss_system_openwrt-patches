config KERNEL_KALLSYMS_ALL
	bool "Include all symbols in kallsyms"
	default n
	depends on KERNEL_KALLSYMS
	help
	  This will give you more information in stack trace from kernel oopses.

if KERNEL_KASAN

	config KERNEL_KASAN_MODULE_TEST
		tristate "KASAN MODULE TEST"
		default n

	config KERNEL_FRAME_WARN
		int "Warn for stack frames larger than"
		default 2048
endif

config KERNEL_PAGE_OWNER
	bool "Page Onwer Tracking"
	default n

config KERNEL_DEBUG_KMEMLEAK
	bool "Kernel memory leak detector"

if KERNEL_DEBUG_KMEMLEAK

	config KERNEL_HAVE_DEBUG_KMEMLEAK
		bool
		default y

	config KERNEL_DEBUG_KMEMLEAK_MEM_POOL_SIZE
		int "Kmemleak memory pool size"
		default 16000

	config KERNEL_DEBUG_KMEMLEAK_TEST
		tristate "Simple test for the kernel memory leak detector"

	config KERNEL_DEBUG_KMEMLEAK_DEFAULT_OFF
		bool "Default kmemleak to off"
endif

config KERNEL_DEFAULT_QDISC_DISABLE
	bool "Disable default qdisc configuration on Network Interfaces"
	default y

config KERNEL_STACKTRACE
	bool "STACK TRACE"
	default n

config KERNEL_HWMON
	tristate "Hardware Monitoring support"
	depends on HAS_IOMEM

config HAS_IOMEM
	bool
	depends on !NO_IOMEM
	select GENERIC_IO
	default y

config KERNEL_CPU_THERMAL
	bool "Enable CPU cooling device support"
	default n

config KERNEL_CPU_FREQ_THERMAL
	bool "Enable CPU frequency cooling device support"
	default n

config KERNEL_SKB_DEBUG
	bool "Enable DEBUG Object support"

config KERNEL_DEBUG_PAGEALLOC
	bool "Debug page memory allocations"

config KERNEL_DEBUG_PAGEALLOC_ENABLE_DEFAULT
	bool "Enable debug page memory allocations by default"

if KERNEL_SKB_DEBUG

	config KERNEL_DEBUG_OBJECTS
		bool "Enable DEBUG Object support to track the lifetime of various objects"
		default y

	config KERNEL_DEBUG_OBJECTS_SELFTEST
		bool "Enable Debug objects selftest"

	config KERNEL_DEBUG_OBJECTS_FREE
		bool "Debug objects in freed memory"

	config KERNEL_DEBUG_OBJECTS_TIMERS
		bool "Debug timer objects"

	config KERNEL_DEBUG_OBJECTS_RCU_HEAD
		bool "Debug RCU callbacks objects"

	config KERNEL_DEBUG_OBJECTS_PERCPU_COUNTER
		bool "Debug percpu counter objects"

	config KERNEL_DEBUG_OBJECTS_WORK
		bool "Debug work objects"

	config KERNEL_DEBUG_OBJECTS_ENABLE_DEFAULT
		int "debug_objects bootup default value (0-1)"
		default 1

	config KERNEL_DEBUG_OBJECTS_SKBUFF
		bool "Debug sk_buff allocations"
		default y
endif

config KERNEL_IPQ_MEM_PROFILE
	int "Different memory profile"
	range 0 1024
	default 0
	help
	  This option select memory profile to used, which defines
	  the reserved memory configuration used in device tree

config KERNEL_ARCH_IPQ256M
	bool "Compile kernel for 256M profile"
	default n
	help
	  Compile kernel for 256M profile, this option enables kernel
	  to add 8MB of DDR to kernel lowmem in 256M profile.

config KERNEL_SKB_FAST_RECYCLABLE_DEBUG_ENABLE
	bool "Enable debug API for fast recycled skb"
	default n

config KERNEL_SKB_RECYCLER_PREALLOC
	bool "Enable preallocation of SKBs"
	default n

config KERNEL_SKB_RECYCLE_MAX_PREALLOC_SKBS
	int "Number of SKBs to be preallocated"
	depends on KERNEL_SKB_RECYCLER_PREALLOC
	default 16384

config KERNEL_SKB_RECYCLER_LOW_MEM
        bool "Enable medium mem for skb recycler"
	default y if KERNEL_IPQ_MEM_PROFILE=512 && TARGET_ipq95xx
	default y if KERNEL_IPQ_MEM_PROFILE=512 && TARGET_ipq53xx
	default y if KERNEL_IPQ_MEM_PROFILE=512 && TARGET_ipq54xx
	default y if KERNEL_IPQ_MEM_PROFILE=256 && TARGET_ipq95xx
        default y if KERNEL_IPQ_MEM_PROFILE=256 && TARGET_ipq53xx
	default y if KERNEL_IPQ_MEM_PROFILE=256 && TARGET_ipq54xx

config KERNEL_SKB_RECYCLER
	bool "Generic skb recycling"
	default y if KERNEL_SKB_RECYCLER_LOW_MEM || KERNEL_IPQ_MEM_PROFILE=0

config KERNEL_SKB_RECYCLER_MULTI_CPU
	bool "Cross-CPU recycling for CPU-locked workloads"
	depends on KERNEL_SKB_RECYCLER
	default y

config KERNEL_SKB_RECYCLE_SIZE
	int "SKB recycler size"
	depends on KERNEL_SKB_RECYCLER
	default 1856 if KERNEL_SKB_RECYCLER_LOW_MEM
	default 2304
	help
	SKB recycler default size

config KERNEL_SKB_FIXED_SIZE_2K
	bool "SKB size fixed at 2K"
	default n
	help
	   SKB size fixed at 2K.

config KERNEL_ALLOC_SKB_PAGE_FRAG_DISABLE
	bool "Disable alloc skb page frag"
	default n

config KERNEL_NET_IPGRE_BROADCAST
	bool "IP: broadcast GRE over IP"
	default y

config KERNEL_DEBUG_MEM_USAGE
	bool "Kernel Memory Tracer"
	default n

config KERNEL_PSTORE
	bool "Persistent store support"
	default n

config KERNEL_PSTORE_CONSOLE
	bool "Log kernel console messages"
	depends on KERNEL_PSTORE
	default n

config KERNEL_PSTORE_PMSG
	bool "Log user space messages"
	depends on KERNEL_PSTORE
	default n

config KERNEL_PSTORE_RAM
	bool "Log panic/oops to a RAM buffer"
	depends on KERNEL_PSTORE
	default n

config KERNEL_ATHMEMDEBUG
	bool "Enable memory debug support for ATH"
	default n

config KERNEL_QCA_MINIDUMP_DEBUG
	bool "Compile the minidump driver with debug enabled"
	default n
	help
	  Enable this option to be debugging and diagnosing issues on Minidump
	  driver.

config KERNEL_GCOV_KERNEL
	bool "TO enable the GCOV KUNIT TEST"
	default n

config KERNEL_IPQ_PROFILE_MINENT
	bool "Select minent build profile"
	default n
	select KERNEL_UBSAN if KERNEL_FTRACE
	help
	Enable/Disable MINENT kernel config. Used to enable specific minent
	features for MINENT profile.

config KERNEL_UBSAN_DIV_ZERO
	bool "Perform checking for integer divide-by-zero"
	depends on KERNEL_UBSAN
	help
	  This option enables -fsanitize=integer-divide-by-zero which checks
	  for integer division by zero. This is effectively redundant with the
	  kernel's existing exception handling, though it can provide greater
	  debugging information under CONFIG_UBSAN_REPORT_FULL.

config KERNEL_UBSAN_UNREACHABLE
	bool "Perform checking for unreachable code"
	depends on KERNEL_UBSAN
	help
	  This option enables -fsanitize=unreachable which checks for control
	  flow reaching an expected-to-be-unreachable position.

config KERNEL_KFENCE
	bool "KFENCE: low-overhead sampling-based memory safety error detector"
	help
	  KFENCE is a low-overhead sampling-based detector of heap out-of-bounds
	  access, use-after-free, and invalid-free errors. KFENCE is designed
	  to have negligible cost to permit enabling it in production
	  environments.

	  See <file:Documentation/dev-tools/kfence.rst> for more details.

	  Note that, KFENCE is not a substitute for explicit testing with tools
	  such as KASAN. KFENCE can detect a subset of bugs that KASAN can
	  detect, albeit at very different performance profiles. If you can
	  afford to use KASAN, continue using KASAN, for example in test
	  environments. If your kernel targets production use, and cannot
	  enable KASAN due to its cost, consider using KFENCE.

if KERNEL_KFENCE

	config KERNEL_KFENCE_SAMPLE_INTERVAL
		int "Default sample interval in milliseconds"
		default 100
		help
		  The KFENCE sample interval determines the frequency with which heap
		  allocations will be guarded by KFENCE. May be overridden via boot
		  parameter "kfence.sample_interval".

		  Set this to 0 to disable KFENCE by default, in which case only
		  setting "kfence.sample_interval" to a non-zero value enables KFENCE.

	config KERNEL_KFENCE_NUM_OBJECTS
		int "Number of guarded objects available"
		range 1 65535
		default 255
		help
		  The number of guarded objects available. For each KFENCE object, 2
		  pages are required; with one containing the object and two adjacent
		  ones used as guard pages.

	config KERNEL_KFENCE_DEFERRABLE
		bool "Use a deferrable timer to trigger allocations"
		help
		  Use a deferrable timer to trigger allocations. This avoids forcing
		  CPU wake-ups if the system is idle, at the risk of a less predictable
		  sample interval.

		  Warning: The KUnit test suite fails with this option enabled - due to
		  the unpredictability of the sample interval!

		  Say N if you are unsure.

	config KERNEL_KFENCE_STRESS_TEST_FAULTS
		int "Stress testing of fault handling and error reporting" if EXPERT
		default 0
		help
		  The inverse probability with which to randomly protect KFENCE object
		  pages, resulting in spurious use-after-frees. The main purpose of
		  this option is to stress test KFENCE with concurrent error reports
		  and allocations/frees. A value of 0 disables stress testing logic.

		  Only for KFENCE testing; set to 0 if you are not a KFENCE developer.

endif

config KERNEL_SECURITYFS
	bool "Enable the securityfs filesystem"
	depends on KERNEL_SECURITY
	help
	  This will build the securityfs filesystem.  It is currently used by
	  various security modules (AppArmor, IMA, SafeSetID, TOMOYO, TPM).

	  If you are unsure how to answer this question, answer N.

config KERNEL_SECURITY_PATH
	bool "Security hooks for pathname based access control"
	depends on KERNEL_SECURITY
	help
	  This enables the security hooks for pathname based access control.
	  If enabled, a security module can use these hooks to
	  implement pathname based access controls.
	  If you are unsure how to answer this question, answer N.

if KERNEL_SECURITY_SELINUX

	config KERNEL_SECURITY_SELINUX_AVC_STATS
		bool "SELinux AVC Statistics"
		default n
		help
		  This option collects access vector cache statistics to
		  /sys/fs/selinux/avc/cache_stats, which may be monitored via
		  tools such as avcstat.

	config KERNEL_DEFAULT_SECURITY_SELINUX
		bool "Use SELinux as default security module"
		default n
		help
		  This option instructs the kernel to use the SELinux security
		  module as the default security module.

endif

#
# KUnit base configuration
#

menuconfig KERNEL_KUNIT
	tristate "KUnit - Enable support for unit tests"
	select GLOB
	help
	  Enables support for kernel unit tests (KUnit), a lightweight unit
	  testing and mocking framework for the Linux kernel. These tests are
	  able to be run locally on a developer's workstation without a VM or
	  special hardware when using UML. Can also be used on most other
	  architectures. For more information, please see
	  Documentation/dev-tools/kunit/.

if KERNEL_KUNIT

    config KERNEL_KUNIT_DEBUGFS
	bool "KUnit - Enable /sys/kernel/debug/kunit debugfs representation" if !KUNIT_ALL_TESTS
	default KERNEL_KUNIT_ALL_TESTS
	help
	  Enable debugfs representation for kunit.  Currently this consists
	  of /sys/kernel/debug/kunit/<test_suite>/results files for each
	  test suite, which allow users to see results of the last test suite
	  run that occurred.

    config KERNEL_KUNIT_FAULT_TEST
	bool "Enable KUnit tests which print BUG stacktraces"
	depends on KERNEL_KUNIT_TEST
	depends on !UML
	default y
	help
	  Enables fault handling tests for the KUnit framework. These tests may
	  trigger a kernel BUG(), and the associated stack trace, even when they
	  pass. If this conflicts with your test infrastrcture (or is confusing
	  or annoying), they can be disabled by setting this to N.

    config KERNEL_KUNIT_TEST
	tristate "KUnit test for KUnit" if !KUNIT_ALL_TESTS
	default KERNEL_KUNIT_ALL_TESTS
	help
	  Enables the unit tests for the KUnit test framework. These tests test
	  the KUnit test framework itself; the tests are both written using
	  KUnit and test KUnit. This option should only be enabled for testing
	  purposes by developers interested in testing that KUnit works as
	  expected.

    config KERNEL_KUNIT_EXAMPLE_TEST
	tristate "Example test for KUnit" if !KUNIT_ALL_TESTS
	default KERNEL_KUNIT_ALL_TESTS
	help
	  Enables an example unit test that illustrates some of the basic
	  features of KUnit. This test only exists to help new users understand
	  what KUnit is and how it is used. Please refer to the example test
	  itself, lib/kunit/example-test.c, for more information. This option
	  is intended for curious hackers who would like to understand how to
	  use KUnit for kernel development.

    config KERNEL_KUNIT_ALL_TESTS
	tristate "All KUnit tests with satisfied dependencies"
	help
	  Enables all KUnit tests, if they can be enabled.
	  KUnit tests run during boot and output the results to the debug log
	  in TAP format (http://testanything.org/). Only useful for kernel devs
	  running the KUnit test harness, and not intended for inclusion into a
	  production build.

	  For more information on KUnit and unit tests in general please refer
	  to the KUnit documentation in Documentation/dev-tools/kunit/.

	  If unsure, say N.

    config KERNEL_KUNIT_DEFAULT_ENABLED
	bool "Default value of kunit.enable"
	default y
	help
	  Sets the default value of kunit.enable. If set to N then KUnit
	  tests will not execute unless kunit.enable=1 is passed to the
	  kernel command line.

	  In most cases this should be left as Y. Only if additional opt-in
	  behavior is needed should this be set to N.

	config KERNEL_ATH_GCOV_PROFILE
	bool "Default value of ATH GCOV profile enable"
	default n
	help
		Enable GCOV profile in ATH packages.

endif # KUNIT

